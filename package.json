{
  "name": "opennars-304-ts-web-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-site.mjs && astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "build": "node scripts/prepare-site.mjs && astro build && node scripts/finalize-site.mjs",
    "build:worker": "node scripts/build-opennars-worker.mjs",
    "check": "npm run typecheck && astro check && npm test && npm run build && node scripts/check-build.mjs",
    "test": "node --experimental-strip-types --test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:nars-operation": "node scripts/nars-operation-contract.mjs",
    "test:nars-action": "node --experimental-strip-types scripts/nars-action-smoke.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "deploy:pages": "node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^20.19.43",
    "astro": "^7.3.5",
    "esbuild": "0.28.2",
    "lucide": "^1.49.0",
    "playwright": "^1.63.0",
    "typescript": "^5.4.5"
  }
}
