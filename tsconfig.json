{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@opennars/*": ["../OpenNARS-304-ts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../OpenNARS-304-ts/src/**/*.d.ts"]
}
