---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../pong-lab.css";
---
<SiteLayout title="NARS Pong · OpenNARS 3.0.4 Lab" description="OpenNARS Pong 玩法与多推理器对照" themeColor="#111713">
  <header class="pong-topbar"><a class="pong-wordmark" href="./" aria-label="返回 Demo Lab"><img class="pong-wordmark-logo" src="./assets/opennars-ts-logo.svg" alt="OpenNARS TypeScript" /><span><small>OPENNARS / 3.0.4</small><strong>PONG PLAYMODES</strong></span></a><nav><a href="./">演示目录</a><a href="./terminal.html">NARS 终端</a></nav><output id="pong-runtime">启动中</output></header>
  <main class="pong-main"><header class="pong-heading"><div><p>PONG / SENSORIMOTOR COMPARISON</p><h1 id="pong-title">NARS Pong</h1><span id="pong-description">选择玩法，观察真实推理器角色如何分工</span></div><label>玩法<select id="pong-mode"></select></label></header>
    <section class="pong-workbench"><div><div class="pong-stage"><canvas id="pong-canvas" width="1000" height="520" aria-label="Pong 感知运动场景"></canvas><div class="pong-fx" aria-hidden="true"></div><div class="pong-rate" aria-label="运行速率"><span><b>FPS</b><output id="fps-hud">-- FPS</output><i id="fps-bar"></i></span><span><b>TPS</b><output id="tps-hud">-- TPS</output><i id="tps-bar"></i></span><span><b>RPS</b><output id="rps-hud">-- RPS</output><i id="rps-bar"></i></span></div></div><div class="pong-controls"><button id="pong-run" type="button" aria-label="暂停" title="暂停"><i data-lucide="pause"></i></button><button id="pong-step" type="button" aria-label="单步" title="单步"><i data-lucide="step-forward"></i></button><button id="pong-reset-world" type="button" aria-label="重置世界" title="重置世界"><i data-lucide="rotate-ccw"></i></button><button id="pong-reset-nars" type="button" aria-label="重置全部 NARS" title="重置全部 NARS"><i data-lucide="brain"></i></button><label>目标 TPS <input id="pong-speed" type="range" min="20" max="60" value="20" /><output id="pong-speed-value">20 TPS</output></label><fieldset><legend>节奏</legend><label><input name="pong-mode" type="radio" value="sync" checked />同步</label><label><input name="pong-mode" type="radio" value="async" />异步</label></fieldset></div></div>
      <aside class="pong-rail"><section class="pong-card"><header><span>当前玩法</span><output id="pong-agent-count">1 NARS</output></header><strong id="pong-mode-label">经典单挡板</strong><small id="pong-role-label">paddle</small></section><section class="pong-card"><header><span>世界状态</span><output id="pong-world-tick">000000</output></header><div class="pong-score"><span>上挡板 <b id="pong-top-hit">0</b>/<b id="pong-top-miss">0</b></span><span>下挡板 <b id="pong-bottom-hit">0</b>/<b id="pong-bottom-miss">0</b></span></div></section><section class="pong-card pong-agents"><header><span>推理器角色</span><small>独立 Worker</small></header><div id="pong-agents"></div></section><details id="pong-experience" class="pong-card"><summary><i data-lucide="brain"></i><span>经验观察</span><output id="pong-experience-status">尚未观察到</output></summary><p id="pong-experience-meta">窗口 96 · 仅收集真实事件</p><ol id="pong-experience-list"></ol></details><section class="pong-card pong-log"><header><span>推理记录</span><button id="pong-clear-log" type="button" aria-label="清除记录"><i data-lucide="trash-2"></i></button></header><ol id="pong-log"></ol></section><div hidden><span id="pong-tps-target"></span><span id="pong-tps-ratio"></span><span id="pong-page-memory"></span><span id="pong-concepts"></span><span id="pong-task-bags"></span></div></aside>
    </section>
  </main>
  <footer class="pong-footer"><span>NARust-o Pong / OpenNARS 3.0.4 适配实验</span><span>多推理器模式显示真实 Worker</span><a href="./COPYING-ONA-MIT.txt">来源与许可</a></footer>
</SiteLayout>
<script>import "../pong-lab.ts";</script>
