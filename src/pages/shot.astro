---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../shot-lab.css";
---
<SiteLayout title="NARS Shot · OpenNARS 3.0.4 Lab" description="NARust-o Shot 六模式 OpenNARS 适配实验" themeColor="#0e1518">
  <header class="shot-topbar"><a class="shot-wordmark" href="./" aria-label="返回 Demo Lab"><span class="shot-mark">N</span><span><small>OPENNARS / 3.0.4</small><strong>SHOT ARENA</strong></span></a><nav><a href="./">演示目录</a><a href="./terminal.html">NARS 终端</a></nav><output id="shot-runtime">启动中</output></header>
  <main class="shot-main"><header class="shot-heading"><div><p>SHOT / EMBODIED MULTI-PLAYER</p><h1 id="shot-title">NARS Shot</h1><span id="shot-description">六种 NARust-o 玩法的 OpenNARS 适配</span></div><label>玩法<select id="shot-mode"></select></label></header>
    <section class="shot-workbench"><div><div class="shot-stage"><canvas id="shot-canvas" width="1000" height="400" aria-label="Shot 多玩家射击场景"></canvas><div class="shot-rate" aria-label="运行速率"><span><b>FPS</b><output id="fps-hud">-- FPS</output><i id="fps-bar"></i></span><span><b>TPS</b><output id="tps-hud">-- TPS</output><i id="tps-bar"></i></span><span><b>RPS</b><output id="rps-hud">-- RPS</output><i id="rps-bar"></i></span></div></div><div class="shot-controls"><button id="shot-run" type="button" aria-label="暂停" title="暂停"><i data-lucide="pause"></i></button><button id="shot-step" type="button" aria-label="单步" title="单步"><i data-lucide="step-forward"></i></button><button id="shot-reset-world" type="button" aria-label="重置世界" title="重置世界"><i data-lucide="rotate-ccw"></i></button><button id="shot-reset-nars" type="button" aria-label="重置全部 NARS" title="重置全部 NARS"><i data-lucide="brain"></i></button><label>目标 TPS <input id="shot-speed" type="range" min="20" max="60" value="20" /><output id="shot-speed-value">20 TPS</output></label><fieldset><legend>节奏</legend><label><input name="shot-mode" type="radio" value="sync" checked />同步</label><label><input name="shot-mode" type="radio" value="async" />异步</label></fieldset></div></div>
      <aside class="shot-rail"><section class="shot-card"><header><span>当前玩法</span><output id="shot-player-count">1 NARS</output></header><strong id="shot-mode-label">静态靶 / 绝对移动</strong><small id="shot-role-label">50 × 20 · 环境角色克隆不复制 NARS 记忆</small></section><section class="shot-card"><header><span>世界状态</span><output id="shot-world-tick">000000</output></header><div class="shot-score"><span>命中 <b id="shot-hits">0</b></span><span>漏射 <b id="shot-misses">0</b></span><span>进化 <b id="shot-evolutions">0</b></span></div></section><section class="shot-card shot-agents"><header><span>NARS 角色</span><small>独立 Worker</small></header><div id="shot-agents"></div></section><details id="shot-experience" class="shot-card"><summary><i data-lucide="brain"></i><span>经验观察</span><output id="shot-experience-status">尚未观察到</output></summary><p id="shot-experience-meta">窗口 96 · 仅收集真实事件</p><ol id="shot-experience-list"></ol></details><section class="shot-card shot-log"><header><span>推理记录</span><button id="shot-clear-log" type="button" aria-label="清除记录"><i data-lucide="trash-2"></i></button></header><ol id="shot-log"></ol></section><div hidden><span id="shot-tps-target"></span><span id="shot-tps-ratio"></span><span id="shot-page-memory"></span><span id="shot-concepts"></span><span id="shot-task-bags"></span></div></aside>
    </section>
  </main>
  <footer class="shot-footer"><span>NARust-o examples/_games/shot / OpenNARS 3.0.4 适配</span><a href="./COPYING-ONA-MIT.txt">来源与许可</a><a href="./">演示目录</a></footer>
</SiteLayout>
<script>import "../shot-lab.ts";</script>
