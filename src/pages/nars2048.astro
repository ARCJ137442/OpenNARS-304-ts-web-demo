---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../nars2048.css";
---
<SiteLayout title="NARS × 2048 · OpenNARS 3.0.4 Lab" description="跨局保留 NARS 记忆的 2048 学习实验">
  <header class="n2048-topbar"><a href="./" aria-label="返回 Demo Lab">← DEMO LAB</a><span>OPENNARS 3.0.4 / NARS × 2048</span><output id="n2048-runtime">启动中</output></header>
  <main class="n2048-main"><header class="n2048-heading"><div><p>LEARNING LAB / PERSISTENT MEMORY</p><h1>NARS × 2048</h1><span>棋盘自动重开，推理记忆保留</span></div><div class="n2048-score"><output id="round">ROUND 01</output><strong id="score">0</strong><small>分数</small></div></header>
    <section class="n2048-workbench"><div><div class="n2048-board-frame"><canvas id="board" class="board" width="720" height="720" aria-label="2048 棋盘"></canvas><div id="rate-hud" class="n2048-rate" aria-label="运行速率"><span><b>FPS</b><output id="fps-hud">-- FPS</output><i id="fps-bar"></i></span><span><b>TPS</b><output id="tps-hud">-- TPS</output><i id="tps-bar"></i></span><span><b>RPS</b><output id="rps-hud">-- RPS</output><i id="rps-bar"></i></span></div></div><div class="n2048-controls"><button id="run" type="button" aria-label="暂停" title="暂停"><i data-lucide="pause"></i></button><button id="reset-board" type="button" aria-label="重开棋盘" title="只重开棋盘"><i data-lucide="rotate-ccw"></i>棋盘</button><button id="reset-memory" type="button" aria-label="重置 NARS 记忆" title="重置 NARS 记忆"><i data-lucide="brain"></i>记忆</button><button id="export-log" type="button" aria-label="导出实验记录" title="导出实验记录"><i data-lucide="download"></i>记录</button><span id="last-event">新局</span><output id="tps-target" hidden></output><output id="tps-ratio" hidden></output><output id="page-memory" hidden></output><output id="concept-count" hidden></output><output id="task-bags" hidden></output></div></div>
      <aside class="n2048-rail"><section><span>最高块</span><strong id="highest">0</strong></section><section><span>局数</span><strong id="round-count">1</strong></section><section><span>操作来源</span><output id="source">WAITING</output></section><section><span>NAR 时间</span><output id="nar-time">0</output></section><section class="n2048-sensors"><span>局面感知</span><div id="sensor-list"></div></section><details id="n2048-experience"><summary>经验观察 <output id="experience-status">尚未观察到</output></summary><p id="experience-meta">窗口 96 · 仅收集真实事件</p><ol id="experience-list"></ol></details><section class="n2048-log"><header><span>实验记录</span><button id="clear-log" type="button" aria-label="清除记录"><i data-lucide="trash-2"></i></button></header><ol id="log"></ol></section></aside>
    </section>
  </main>
  <footer class="n2048-footer"><span>参考规则：jev-2048 / MIT · 本页面为独立 TypeScript 实现</span><a href="./COPYING-JEV-2048-MIT.txt">Jev MIT 许可</a></footer>
</SiteLayout>
<script>import "../nars2048.ts";</script>
