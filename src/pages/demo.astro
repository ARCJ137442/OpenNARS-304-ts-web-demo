---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../demo.css";
import "../nars-controls.css";
---

<SiteLayout title="NARS 感知运动 · OpenNARS 3.0.4 Lab" themeColor="#111713">
  <header class="demo-header"><a class="back-link" href="./" aria-label="演示目录"><span aria-hidden="true">←</span><span>DEMO LAB</span></a><div class="demo-brand"><small>OPENNARS 3.0.4 / SENSORIMOTOR</small><strong id="game-title">加载演示</strong></div><span id="game-runtime" class="runtime-state"><i></i><span id="runtime-label">启动中</span></span></header>
  <main class="demo-main">
    <section class="demo-stage">
      <div class="stage-heading"><div><p id="game-family" class="eyebrow">ENVIRONMENT MODEL</p><h1 id="game-subtitle">NARS 感知与行动</h1><button id="source-toggle" class="source-toggle" type="button" aria-expanded="false"><i data-lucide="info"></i><span>来源</span></button></div><div class="step-clock"><small>ENV STEP</small><output id="game-step">000000</output></div></div>
      <p id="source-copy" class="source-copy" hidden></p>
      <div class="game-canvas-frame"><canvas id="game-canvas" width="800" height="600" aria-label="NARS 感知运动演示"></canvas><span id="game-status" class="game-status">启动中</span><div id="rate-hud" class="rate-hud" aria-label="运行速率"><span><b>FPS</b><output id="fps-hud">-- FPS</output><i id="fps-bar" aria-hidden="true"></i></span><span><b>TPS</b><output id="tps-hud">-- TPS</output><i id="tps-bar" aria-hidden="true"></i></span><span><b>RPS</b><output id="rps-hud">-- RPS</output><i id="rps-bar" aria-hidden="true"></i></span></div></div>
      <div class="game-controls"><button id="run-toggle" class="main-control" type="button"><span id="run-icon"><i data-lucide="pause"></i></span><span id="run-label" class="sr-only">暂停</span></button><button id="step-once" type="button" aria-label="单步" title="单步"><i data-lucide="step-forward"></i><span>单步</span></button><button id="reset-demo" type="button" aria-label="重置" title="重置"><i data-lucide="rotate-ccw"></i><span>重置</span></button><label for="speed">TPS <input id="speed" type="range" min="20" max="60" value="20" /><output id="speed-label">20 TPS</output></label><fieldset class="mode-switch"><legend>节奏</legend><label><input id="mode-sync" type="radio" name="runtime-mode" value="sync" checked />同步</label><label><input id="mode-async" type="radio" name="runtime-mode" value="async" />异步</label></fieldset><button id="toggle-rate-hud" type="button" aria-label="隐藏速率 HUD" title="隐藏速率 HUD"><i data-lucide="eye"></i><span>HUD</span></button><button id="new-seed" class="quiet" type="button" aria-label="新布局" title="新布局"><i data-lucide="dices"></i><span>新布局</span></button></div>
      <div class="nars-controls" aria-label="NARS 参数"><label for="cycles-control"><span class="nars-control-name"><i data-lucide="activity"></i><span>Cycles / 步</span></span><input id="cycles-control" type="range" min="1" max="40" value="10" /><output id="cycles-label">10</output></label><label for="babble-control"><span class="nars-control-name"><i data-lucide="dices"></i><span>Babble</span></span><input id="babble-control" type="range" min="0" max="30" value="8" /><output id="babble-label">8%</output></label></div>
      <div id="manual-controls" class="manual-controls" role="group" aria-label="直接操控"></div>
      <details class="diagnostics-panel"><summary><i data-lucide="activity"></i><span>性能诊断</span></summary><div class="diagnostic-grid"><label>模式 <output id="runtime-mode">同步</output></label><label>目标 TPS <output id="tps-target">20.0 TPS</output></label><label>TPS 比例 <output id="tps-ratio">--%</output></label><label>页面内存 <output id="page-memory">读取中</output></label><label>概念袋 <output id="concept-count">等待 NARS</output></label><label>任务袋 <output id="task-bags">等待 NARS</output></label><label>Worker 队列 <output id="runtime-queue">待处理 0</output></label><label>迟到动作 <output id="late-actions">0</output></label></div></details>
      <details id="echo-map-details" class="diagnostics-panel" hidden><summary><i data-lucide="map"></i><span>地图认知 / 真值对照</span></summary><div class="echo-map-grid"><figure><figcaption>真实地图</figcaption><canvas id="echo-truth-map" width="360" height="280" aria-label="环境真实地图"></canvas></figure><figure><figcaption>已知地图</figcaption><canvas id="echo-known-map" width="360" height="280" aria-label="NARS 可见的已知地图"></canvas></figure></div><p class="echo-map-note">真实墙体只供观察；NARS 输入仅包含已探测墙面与回声。</p></details>
    </section>

    <aside class="monitor-rail" aria-label="NARS 监视器">
      <section class="monitor operation-monitor"><header><span>EXECUTION / OPERATION</span><output id="operation-source">WAITING</output></header><strong id="operation-value">等待操作</strong><p id="operation-state">操作由 NARS Worker 内的操作符执行</p></section>
      <section class="monitor metrics-monitor"><header><span>ENVIRONMENT / SCORE</span><output id="game-score-label">SCORE</output></header><div id="game-metrics" class="game-metrics"></div></section>
      <section class="monitor sensor-monitor"><header><span>PERCEPTUAL INPUT</span><output id="sensor-summary">—</output></header><div id="sensor-values" class="sensor-values"></div></section>
      <section class="monitor activity-monitor"><header><div><span>INFERENCE / ACTIVITY</span><strong>NARS 日志</strong></div><button id="clear-log" type="button" aria-label="清除日志" title="清除日志"><i data-lucide="trash-2"></i></button></header><div class="log-tabs" role="tablist"><button role="tab" aria-selected="true" data-filter="all">全部</button><button role="tab" aria-selected="false" data-filter="operation">操作</button><button role="tab" aria-selected="false" data-filter="input">感知输入</button></div><ol id="game-log" aria-live="polite"></ol></section>
      <details id="experience-panel" class="monitor experience-panel"><summary><i data-lucide="brain"></i><span>经验观察</span><output id="experience-status">尚未观察到</output></summary><p id="experience-meta" class="experience-meta-note">窗口 96 · 仅收集真实事件</p><ol id="experience-list" class="experience-list" aria-live="polite"></ol></details>
    </aside>
  </main>
  <footer class="demo-footer"><span>AI-ASSISTED PORT / GPT-6 SOL HIGH</span><a href="./COPYING-GPL-3.0.txt">LICENSE & ATTRIBUTION</a><a href="./">演示目录</a></footer>
</SiteLayout>

<script>
  import "../demo.ts";
</script>
