---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../gridworld.css";
import "../ui/reasoner-panel.css";
---

<SiteLayout title="Grid Microworld · OpenNARS 3.0.4 Lab" description="在方格、三角格和六角格环面中观察 OpenNARS 感知与操作" themeColor="#111713">
  <header class="grid-topbar">
    <a class="grid-wordmark" href="./" aria-label="返回 Demo Lab"><img class="grid-wordmark-logo" src="./assets/opennars-ts-logo.svg" alt="OpenNARS TypeScript" /><span><small>OPENNARS / 3.0.4</small><strong>GRID MICROWORLD</strong></span></a>
    <nav aria-label="Lab 导航"><a href="./">演示目录</a><a href="./terminal.html">NARS 终端</a></nav>
    <span id="grid-runtime" class="grid-runtime" data-state="booting">启动中</span>
  </header>

  <main class="grid-main">
    <header class="grid-intro"><div><p class="eyebrow">GRID MICROWORLD / SENSORIMOTOR</p><h1>格中虫脑</h1><p>同一感知—操作闭环，三种离散世界</p></div><span id="topology-mark" class="topology-mark" aria-hidden="true">□</span></header>

    <div class="grid-workbench">
      <section class="grid-stage" aria-label="网格微世界">
        <div class="grid-canvas-frame"><canvas id="grid-canvas" width="960" height="600" aria-label="网格微世界场景"></canvas><div class="grid-rate" aria-label="运行速率"><span id="grid-status">运行中</span><output id="step-count">000000</output><output id="fps-hud">-- FPS</output><output id="tps-hud">-- TPS</output><output id="rps-hud">-- RPS</output><i id="fps-bar" aria-hidden="true"></i><i id="tps-bar" aria-hidden="true"></i><i id="rps-bar" aria-hidden="true"></i></div></div>
        <div class="transport grid-control-row"><button id="grid-run" class="primary-control" type="button" aria-label="暂停" title="暂停"><i data-lucide="pause"></i></button><button id="grid-step" type="button" aria-label="单步" title="单步"><i data-lucide="step-forward"></i></button><button id="grid-reset" type="button" aria-label="重置世界与 NARS" title="重置"><i data-lucide="rotate-ccw"></i></button><label class="speed-control">速度 <input id="grid-speed" type="range" min="20" max="50" value="20" /><output id="grid-speed-value">20 TPS</output></label><fieldset><legend>节奏</legend><label><input name="grid-mode" type="radio" value="sync" checked />同步</label><label><input name="grid-mode" type="radio" value="async" />异步</label></fieldset><button id="grid-toggle-rate-hud" class="quiet-control" type="button" aria-label="隐藏速率 HUD" title="隐藏速率 HUD"><i data-lucide="eye"></i><span>HUD</span></button></div>
        <div class="nars-parameters grid-config-row"><label>格形 <select id="grid-topology"><option value="square">正方形</option><option value="triangle">正三角形</option><option value="hexagon">正六边形</option></select></label><label>列 <input id="grid-cols" type="range" min="4" max="20" value="10" /><output id="grid-cols-value">10</output></label><label>行 <input id="grid-rows" type="range" min="4" max="20" value="8" /><output id="grid-rows-value">8</output></label><label>推理步/刻 <input id="grid-cycles" type="range" min="1" max="40" value="10" /><output id="grid-cycles-value">10</output></label><label>探索 <input id="grid-babble" type="range" min="0" max="30" value="10" /><output id="grid-babble-value">10%</output></label></div>
        <div class="manual-controls grid-manual" role="group" aria-label="直接控制虫体"><span class="manual-label">手动输入</span><button type="button" data-grid-action="2" aria-label="左转" title="逆时针左转"><i data-lucide="arrow-left"></i><span>左转</span></button><button type="button" data-grid-action="3" aria-label="前进" title="前进一格"><i data-lucide="arrow-up"></i><span>前进</span></button><button type="button" data-grid-action="1" aria-label="右转" title="顺时针右转"><i data-lucide="arrow-right"></i><span>右转</span></button></div>
      </section>

      <aside class="instrument-rail nars-panel-rail" aria-label="NARS 状态监视">
        <section class="instrument decision-panel">
          <header><span class="eyebrow">NARS EXECUTION</span><span id="decision-source" class="source-tag">WAITING</span></header>
          <output id="current-operation" class="current-operation" aria-live="polite" aria-atomic="true">等待第一步</output>
          <p id="operation-detail" class="operation-detail">每个环境步运行 10 个推理周期</p>
        </section>
        <section class="instrument perception-panel">
          <header><span class="eyebrow">SENSORY FIELD</span><output id="sensor-focus">暂无目标</output></header>
          <div id="sensor-grid" class="sensor-grid" aria-label="六路感受输入"></div>
          <div class="sensor-key"><span><i></i>好食物</span><span><i></i>坏食物</span></div>
        </section>
        <section class="instrument reward-panel">
          <header><span class="eyebrow">OUTCOME / REWARD</span><output id="reward-state">尚无反馈</output></header>
          <div class="reward-counts">
            <div><span>好食物</span><strong id="good-count">0</strong></div>
            <div><span>坏食物</span><strong id="bad-count">0</strong></div>
            <div><span>好 / 坏比</span><strong id="food-ratio">1.00</strong></div>
          </div>
          <div class="ratio-track"><span id="ratio-fill"></span></div>
        </section>
        <section class="instrument log-panel">
          <header class="log-heading"><div><span class="eyebrow">NARS ACTIVITY</span><h2>推理记录</h2></div><button id="clear-log" type="button" aria-label="清除日志" title="清除日志"><i data-lucide="trash-2"></i></button></header>
          <div class="log-filters" role="tablist" aria-label="日志筛选">
            <button type="button" role="tab" aria-selected="true" data-log-filter="all">全部</button>
            <button type="button" role="tab" aria-selected="false" data-log-filter="operation">操作</button>
            <button type="button" role="tab" aria-selected="false" data-log-filter="learning">输入 / 奖励</button>
          </div>
          <ol id="nars-log" class="nars-log" aria-live="polite" aria-label="NARS 事件记录"></ol>
        </section>
        <details id="experience-panel" class="instrument experience-panel">
          <summary><i data-lucide="brain"></i><span>经验观察</span><output id="experience-status">尚未观察到</output></summary>
          <p id="experience-meta" class="experience-meta-note">窗口 96 · 仅收集真实事件</p>
          <ol id="experience-list" class="experience-list" aria-live="polite"></ol>
        </details>
        <details class="instrument diagnostics-panel">
          <summary><i data-lucide="activity"></i><span>性能诊断</span></summary>
          <div class="diagnostic-grid">
            <label>节奏 <output id="runtime-mode-value">同步</output></label>
            <label>目标 TPS <output id="tps-target">20.0 TPS</output></label>
            <label>TPS 比例 <output id="tps-ratio">--%</output></label>
            <label>NARS 延迟 <output id="runtime-latency">0 ms</output></label>
            <label>推理状态 <output id="runtime-pending">空闲</output></label>
            <label>页面内存 <output id="page-memory">读取中</output></label>
            <label>概念袋 <output id="concept-count">等待 NARS</output></label>
            <label>任务袋 <output id="task-bags">等待 NARS</output></label>
          </div>
        </details>
      </aside>
    </div>
  </main>

  <footer class="lab-footer"><span>GRID MICROWORLD / OPENNARS 3.0.4 TS</span><span>新环境 · 非经典 Microworld 性能替代</span><a href="./">演示目录</a></footer>
</SiteLayout>

<script>import "../gridworld.ts";</script>
